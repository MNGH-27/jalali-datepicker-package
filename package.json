{
  "name": "@mngh/jalali-datepicker",
  "version": "1.0.0",
  "description": "Modern, accessible, and lightweight Jalali (Persian/Shamsi) Date & Time Picker for React.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "keywords": [
    "jalali",
    "jalali-datepicker",
    "jalali-calendar",
    "persian-datepicker",
    "shamsi-datepicker",
    "react-datepicker",
    "react-jalali",
    "timepicker",
    "date-range-picker"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest --config vitest.unit.config.ts",
    "storybook": "storybook dev -p 6006"
  }
}
