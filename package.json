{
  "name": "@mngh/jalali-datepicker",
  "version": "1.0.3",
  "description": "A modern, zero-dependency, lightweight, accessible, and highly customizable Jalali (Persian/Shamsi) Date & Time Picker for React.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "author": {
    "name": "mohsen nouri",
    "url": "https://github.com/MNGH-27"
  },
  "contributors": [
    {
      "name": "mngh",
      "url": "https://github.com/MNGH-27"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MNGH-27/jalali-datepicker-package.git"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "keywords": [
    "jalali",
    "jalali-datepicker",
    "jalali-calendar",
    "persian-datepicker",
    "shamsi-datepicker",
    "persian-calendar",
    "react-datepicker",
    "react-jalali",
    "react-jalali-datepicker",
    "timepicker",
    "date-range-picker",
    "shamsi",
    "تقویم-شمسی",
    "تقویم-جلالی"
  ],
  "homepage": "https://github.com/MNGH-27/jalali-datepicker-package#readme",
  "bugs": {
    "url": "https://github.com/MNGH-27/jalali-datepicker-package/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest --config vitest.unit.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  }
}
