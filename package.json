{
  "name": "@mngh/jalali-datepicker",
  "version": "1.0.0",
  "description": "A modern, zero-dependency, lightweight, accessible, and highly customizable Jalali (Persian/Shamsi) Date & Time Picker for React.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "author": {
    "name": "mohsen nourti",
    "url": "https://github.com/MNGH-27"
  },
  "contributors": [
    {
      "name": "mngh",
      "url": "https://github.com/MNGH-27"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MNGH-27/jalali-datepicker-package"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "keywords": [
    "jalali",
    "jalali-datepicker",
    "jalali-calendar",
    "persian-datepicker",
    "shamsi-datepicker",
    "persian-calendar",
    "react-datepicker",
    "react-jalali",
    "react-jalali-datepicker",
    "timepicker",
    "date-range-picker",
    "shamsi",
    "تقویم-شمسی",
    "تقویم-جلالی"
  ],
  "homepage": "https://github.com/MNGH-27/jalali-datepicker-package#readme",
  "bugs": {
    "url": "https://github.com/MNGH-27/jalali-datepicker-package/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest --config vitest.unit.config.ts",
    "storybook": "storybook dev -p 6006"
  }
}
